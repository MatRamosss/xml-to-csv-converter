<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>XML Sitemap to CSV Converter</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <style>
        body { font-family: 'Inter', sans-serif; background-color: #f7f7f7; }
        /* Custom scrollbar for the textarea */
        textarea::-webkit-scrollbar { width: 8px; }
        textarea::-webkit-scrollbar-thumb { background-color: #9ca3af; border-radius: 4px; }
        textarea::-webkit-scrollbar-track { background-color: #e5e7eb; }
    </style>
</head>
<body class="p-4 sm:p-8 min-h-screen flex items-center justify-center">

    <div class="w-full max-w-4xl bg-white shadow-2xl rounded-xl p-6 md:p-10 border border-gray-100">
        <h1 class="text-3xl font-extrabold text-gray-900 mb-2 text-indigo-700">XML Sitemap to CSV Converter</h1>
        <p class="text-gray-500 mb-6">Paste your raw XML sitemap data below. The tool now supports both **URL Sitemaps** (`<url>`) and **Sitemap Index Files** (`<sitemap>`).</p>

        <!-- XML Content Input (Now with generic placeholder data) -->
        <textarea
            id="xml-content"
            rows="10"
            class="w-full p-4 border-2 border-gray-300 rounded-lg focus:ring-4 focus:ring-indigo-200 focus:border-indigo-500 transition duration-150 text-sm font-mono resize-none"
            placeholder="Paste your XML sitemap content here..."
        >
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
 <url>
  <loc>https://example.com/products/widgets</loc>
  <lastmod>2024-11-06T10:00:00+00:00</lastmod>
  <changefreq>Weekly</changefreq>
  <priority>1.0</priority>
 </url>
 <url>
  <loc>https://example.com/about-us</loc>
  <lastmod>2024-01-15T12:30:00+00:00</lastmod>
  <priority>0.8</priority>
 </url>
 <url>
  <loc>https://example.com/blog/latest-post</loc>
  <lastmod>2024-11-05T18:00:00+00:00</lastmod>
  <changefreq>Daily</changefreq>
 </url>
</urlset>
        </textarea>

        <!-- Configuration -->
        <div class="mt-6 grid grid-cols-1 md:grid-cols-2 gap-4">
            
            <!-- Output Separator -->
            <div>
                <label for="outputDelimiterSelect" class="block text-sm font-medium text-gray-700 mb-1">Output Separator (For Final File):</label>
                <select id="outputDelimiterSelect" class="mt-1 block w-full pl-3 pr-10 py-2 text-base border-gray-300 focus:outline-none focus:ring-indigo-500 focus:border-indigo-500 sm:text-sm rounded-lg">
                    <option value=",">Comma (Standard CSV)</option>
                    <option value=";">Semicolon (Excel friendly)</option>
                    <option value="\t">Tab (TSV)</option>
                    <option value="|">Pipe</option>
                </select>
            </div>

            <!-- File Name Input -->
            <div>
                <label for="fileNameInput" class="block text-sm font-medium text-gray-700 mb-1">File Name (.csv):</label>
                <input type="text" id="fileNameInput" value="sitemap_export" 
                       class="mt-1 block w-full p-2 border border-gray-300 rounded-lg focus:ring-indigo-500 focus:border-indigo-500 sm:text-sm"
                       placeholder="Enter file name">
            </div>
        </div>

        <!-- Download Button -->
        <button
            onclick="downloadCSV()"
            class="mt-6 w-full px-8 py-3 bg-indigo-600 text-white font-semibold text-lg rounded-lg shadow-md hover:bg-indigo-700 transition duration-200 focus:outline-none focus:ring-4 focus:ring-indigo-500 focus:ring-opacity-50 active:bg-indigo-800 flex items-center justify-center"
        >
            <svg class="h-6 w-6 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"></path></svg>
            Convert XML & Download File
        </button>
        
        <!-- Instructions/Tips -->
        <div class="mt-8 p-4 bg-indigo-50 rounded-lg text-indigo-800">
            <h3 class="font-bold text-lg mb-2">How Conversion Works:</h3>
            <ul class="list-disc list-inside text-sm space-y-1">
                <li>**Intelligent Detection:** The tool checks if your XML contains **`<url>`** blocks (standard sitemap) or **`<sitemap>`** blocks (sitemap index).</li>
                <li>**URL Sitemaps:** Parsed fields are URL, Date Modified, Time Modified, Change Frequency, Priority.</li>
                <li>**Index Sitemaps:** Parsed fields are Sitemap URL, Date Modified, and Time Modified.</li>
                <li>The `<lastmod>` timestamp is always split into separate Date and Time columns for easier analysis.</li>
            </ul>
        </div>
    </div>

    <script>
        /**
         * Simple custom message box (instead of alert)
         * @param {string} message - The message to display.
         * @param {boolean} isError - If true, displays a red error box.
         */
        function showMessageBox(message, isError = false) {
            let messageBox = document.getElementById('message-box');
            if (!messageBox) {
                messageBox = document.createElement('div');
                messageBox.id = 'message-box';
                messageBox.className = 'fixed top-4 right-4 px-6 py-3 rounded-lg shadow-xl transition-transform transform translate-x-full duration-300 z-50 text-white';
                document.body.appendChild(messageBox);
            }
            
            // Set styles based on error status
            messageBox.classList.remove('bg-green-500', 'bg-red-500');
            if (isError) {
                messageBox.classList.add('bg-red-500');
            } else {
                messageBox.classList.add('bg-green-500');
            }

            messageBox.textContent = message;
            
            // Show the box
            messageBox.classList.remove('translate-x-full');
            
            // Hide the box after 3 seconds
            setTimeout(() => {
                messageBox.classList.add('translate-x-full');
            }, 3000);
        }

        /**
         * Extracts content from a specific tag within an XML block.
         * @param {string} xmlBlock - The XML string (e.g., contents of one <url> or <sitemap> block).
         * @param {string} tagName - The name of the tag to extract (e.g., 'loc').
         * @returns {string} The extracted content, or an empty string if not found.
         */
        function extractTagContent(xmlBlock, tagName) {
            // Regex to match <tag>content</tag>, ignoring internal whitespace
            // It searches for the tag name case-insensitively
            const regex = new RegExp(`<${tagName}>\\s*([^<]*?)\\s*<\\/${tagName}>`, 'i');
            const match = xmlBlock.match(regex);
            // Return captured group 1 (the content) or an empty string
            return match ? match[1].trim() : "";
        }

        /**
         * Parses XML sitemap content, converts it to CSV, and triggers a download.
         */
        function downloadCSV() {
            const rawXml = document.getElementById('xml-content').value;
            const fileNameInput = document.getElementById('fileNameInput').value.trim();
            const outputDelimiter = document.getElementById('outputDelimiterSelect').value;

            if (!rawXml.trim()) {
                 showMessageBox('Please paste your XML sitemap content to convert.', true);
                 return;
            }

            // Convert string representation ('\t') to the actual character
            const mapChar = (value) => value === '\\t' ? '\t' : value;
            const outputChar = mapChar(outputDelimiter);
            
            // --- 1. XML Parsing Setup ---

            const csvRows = [];
            let urlCount = 0;
            let match;
            
            // Case-insensitive checks for sitemap types
            const rawXmlLower = rawXml.toLowerCase();
            const isUrlSet = rawXmlLower.includes('<url>');
            const isSitemapIndex = rawXmlLower.includes('<sitemap>');

            // Helper to quote fields if they contain the delimiter or quotes
            const quoteField = (field) => {
                field = field.replace(/"/g, '""'); // Escape double quotes
                if (field.includes(outputChar) || field.includes('\n') || field.includes('"')) {
                    return `"${field}"`;
                }
                return field;
            };

            // --- 2. Determine Sitemap Type and Parse ---

            if (isUrlSet) {
                // Scenario 1: Standard URL Sitemap (contains <url>)
                const urlBlockRegex = /<url>([\s\S]*?)<\/url>/gi;
                const headers = ["URL", "Date Modified", "Time Modified", "Change Frequency", "Priority"];
                csvRows.push(headers.join(outputChar));

                while ((match = urlBlockRegex.exec(rawXml)) !== null) {
                    const urlBlock = match[1];
                    
                    // Extract fields
                    const loc = extractTagContent(urlBlock, 'loc');
                    const lastmodRaw = extractTagContent(urlBlock, 'lastmod');
                    const changefreq = extractTagContent(urlBlock, 'changefreq');
                    const priority = extractTagContent(urlBlock, 'priority');

                    // Split the timestamp
                    let dateModified = '';
                    let timeModified = '';

                    if (lastmodRaw) {
                        const parts = lastmodRaw.split('T');
                        dateModified = parts[0] || '';
                        timeModified = parts[1] || '';
                    }
                    
                    if (loc) {
                        urlCount++;
                        const row = [
                            quoteField(loc), 
                            quoteField(dateModified), 
                            quoteField(timeModified), 
                            quoteField(changefreq), 
                            quoteField(priority)
                        ];
                        csvRows.push(row.join(outputChar));
                    }
                }

            } else if (isSitemapIndex) {
                // Scenario 2: Sitemap Index File (contains <sitemap>)
                const sitemapBlockRegex = /<sitemap>([\s\S]*?)<\/sitemap>/gi;
                const headers = ["Sitemap URL", "Date Modified", "Time Modified"];
                csvRows.push(headers.join(outputChar));

                while ((match = sitemapBlockRegex.exec(rawXml)) !== null) {
                    const sitemapBlock = match[1];
                    
                    // Extract fields
                    const loc = extractTagContent(sitemapBlock, 'loc');
                    const lastmodRaw = extractTagContent(sitemapBlock, 'lastmod');

                    // Split the timestamp
                    let dateModified = '';
                    let timeModified = '';

                    if (lastmodRaw) {
                        const parts = lastmodRaw.split('T');
                        dateModified = parts[0] || '';
                        timeModified = parts[1] || '';
                    }
                    
                    if (loc) {
                        urlCount++;
                        // Index files only have URL and Lastmod
                        const row = [
                            quoteField(loc), 
                            quoteField(dateModified), 
                            quoteField(timeModified)
                        ];
                        csvRows.push(row.join(outputChar));
                    }
                }
            } else {
                 showMessageBox('Error: XML content does not contain recognized <url> or <sitemap> blocks. Please check the format.', true);
                 return;
            }
            
            if (urlCount === 0) {
                 showMessageBox('No sitemap entries were found. Please check your XML content.', true);
                 return;
            }

            const csvContent = csvRows.join('\n');


            // --- 3. Prepare File Name and Trigger Download ---
            
            let fileName = fileNameInput || 'sitemap_export';
            if (!fileName.toLowerCase().endsWith(".csv")) {
                fileName += ".csv";
            }
            
            // Add BOM for UTF-8 compatibility with Excel
            const blob = new Blob(["\ufeff", csvContent], { type: 'text/csv;charset=utf-8;' });
            
            const url = URL.createObjectURL(blob);
            const a = document.createElement('a');
            a.style.display = 'none';
            a.href = url;
            a.download = fileName;
            
            document.body.appendChild(a);
            a.click();
            
            URL.revokeObjectURL(url);

            showMessageBox(`Successfully converted ${urlCount} entries to CSV and downloaded '${fileName}'.`);
        }
    </script>
</body>
</html>
